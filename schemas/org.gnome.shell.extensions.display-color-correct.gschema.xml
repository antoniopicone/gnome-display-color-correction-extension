<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.display-color-correct"
          path="/org/gnome/shell/extensions/display-color-correct/">
    <key name="red-factor" type="d">
      <default>1.0</default>
      <summary>Red channel brightness factor (default / fallback)</summary>
    </key>
    <key name="green-factor" type="d">
      <default>1.0</default>
      <summary>Green channel brightness factor (default / fallback)</summary>
    </key>
    <key name="blue-factor" type="d">
      <default>1.0</default>
      <summary>Blue channel brightness factor (default / fallback)</summary>
    </key>
    <key name="red-saturation" type="d">
      <default>0.73</default>
      <summary>Red channel saturation factor (default / fallback)</summary>
    </key>
    <key name="green-saturation" type="d">
      <default>0.90</default>
      <summary>Green channel saturation factor (default / fallback)</summary>
    </key>
    <key name="blue-saturation" type="d">
      <default>0.93</default>
      <summary>Blue channel saturation factor (default / fallback)</summary>
    </key>
    <key name="monitor-overrides" type="s">
      <default>'{}'</default>
      <summary>Per-monitor overrides</summary>
      <description>
        JSON object keyed by monitor connector name (e.g. "eDP-1", "DP-2"),
        each value an object with r/g/b (brightness) and rSat/gSat/bSat
        (saturation) doubles. Monitors without an entry fall back to the
        red-factor/green-factor/... default keys.
      </description>
    </key>
  </schema>
</schemalist>
